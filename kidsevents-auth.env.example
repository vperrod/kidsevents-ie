# Copy to a protected path outside the repository, then reference it from the
# systemd service with EnvironmentFile=. The Firebase API key is public web
# configuration; do not put a Firebase Admin service-account JSON in this file.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Point this at a service-account JSON stored outside the repository. The
# process identity must be able to read it.
GOOGLE_APPLICATION_CREDENTIALS=/etc/kidsevents/firebase-service-account.json
